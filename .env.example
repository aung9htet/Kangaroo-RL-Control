# Copy to .env (git-ignored) to override defaults. All values are optional.

# Host user ids so files written in the container are owned by you on the host
# (`id -u`, `id -g`). Compose does not export the shell's UID automatically.
HOST_UID=1000
HOST_GID=1000

# Where checkpoints, videos and tables go. Point RESULTS_DIR at a larger volume if the
# measured raw-video size will not fit next to the checkout. The directories must exist.
# RESULTS_DIR=/mnt/bigdisk/natural_rl_results
# DATA_DIR=./data

# Simulator base image (private Docker Hub repo; `docker login` first), or a locally built tag.
# BASE_IMAGE=aung9htet/kangaroo-libero:0.1.0-ubuntu-22.04

# CPU threads per process inside the container.
# OMP_NUM_THREADS=4

# GPU via CDI (needs the NVIDIA Container Toolkit CDI spec; see compose.gpu.yaml). Uncomment to add it.
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
